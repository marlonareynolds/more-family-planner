# Copy to .env.local. Nothing here is required for local development:
# without DATABASE_URL the app uses an embedded database in .data/, and
# without Supabase keys it uses synthetic development sign-in.

# Postgres (Supabase, London region). Use the pooled URL for the app and the
# direct URL when running `pnpm db:migrate`.
DATABASE_URL=

# Supabase Auth (email magic links). Setting both turns development sign-in off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs development sessions. Required in production if dev sign-in is allowed.
MORE_SESSION_SECRET=
# Only for a private preview with synthetic people. Never set in production.
MORE_ALLOW_DEV_AUTH=
# Demo deployments only: embedded database in /tmp that resets. Never with real data.
MORE_DEMO_DB=

# Protects the notification worker endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
