# Copy to .env.local. Nothing here is required for local development:
# without DATABASE_URL the app uses an embedded database in .data/, and
# without Supabase keys it uses synthetic development sign-in.

# Postgres (Supabase, London region). Use the pooled URL for the app and the
# direct URL when running `pnpm db:migrate`.
DATABASE_URL=

# Supabase Auth (email magic links). Setting both turns development sign-in off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs development sessions and seals calendar tokens. Required in production once calendar sync is on.
MORE_SESSION_SECRET=
# Only for a private preview with synthetic people. Never set in production.
MORE_ALLOW_DEV_AUTH=
# Demo deployments only: embedded database in /tmp that resets. Never with real data.
MORE_DEMO_DB=

# Protects the notification worker endpoint (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# The app's public address, used for links in emails and text messages.
MORE_APP_URL=

# Phone notifications (web push). Generate with `pnpm vapid`. Leave empty to keep push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sunday "week ahead" email via Resend. Leave empty to keep email off.
RESEND_API_KEY=
EMAIL_FROM=
# Where help-page messages are emailed (needs RESEND_API_KEY). They are always
# kept in the support_requests table either way.
MORE_SUPPORT_EMAIL=

# Two-way calendar sync. Without these the "Connect Google / Outlook" buttons stay hidden.
# Calendar tokens are sealed at rest with a key from MORE_SESSION_SECRET, so set that too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
